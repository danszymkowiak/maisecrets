#!/bin/bash
# maisecrets pre-commit: fast checks that must hold on every commit.
#   1. no secret or PII in the staged diff (our own detector, dogfooding)
#   2. JSON manifests parse
#   3. lint as the CI job runs it, 4. manifests agree, 5. plugin validator, 6. unit tests
# Install: scripts/install-hooks.sh
set -u
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT" || exit 1

# 1. staged additions through the detector
# the vendored ruleset legitimately contains secret SHAPES (its own regexes), so it is excluded
ADDED=$(git diff --cached --unified=0 --no-color -- . ':(exclude)maisecrets/rules/*' | grep -E '^\+' | grep -vE '^\+\+\+' | sed 's/^+//')
if [ -n "$ADDED" ]; then
  HITS=$(printf '%s\n' "$ADDED" | python3 -m maisecrets.cli scan 2>/dev/null | grep -E '^SECRET ' || true)
  if [ -n "$HITS" ]; then
    echo "pre-commit: the staged diff carries values the detector treats as secrets:"
    echo "$HITS"
    echo "Remove them, or use a placeholder like <SECRET_c1> in tests and docs."
    exit 1
  fi
fi

# 2. manifests
for f in .claude-plugin/plugin.json .claude-plugin/marketplace.json hooks/hooks.json; do
  python3 -c "import json,sys; json.load(open('$f'))" || { echo "pre-commit: $f is not valid JSON"; exit 1; }
done

# 2b. the plugin files as a directory check reads them: frontmatter YAML, manifests, hook paths,
# command names. `claude plugin validate --strict` passed a frontmatter that the directory check
# refused (2026-09-28), so this runs on every commit
python3 scripts/lint_plugin.py || { echo "pre-commit: scripts/lint_plugin.py failed"; exit 1; }

# 2c. the layers of redact and bench (TASK-62): import-linter contracts in each pyproject.toml
if command -v uv >/dev/null 2>&1; then
  for proj in redact bench; do
    OUT=$(uv run --quiet --project "$proj" --group dev lint-imports --no-cache --config "$proj/pyproject.toml" 2>&1) || {
      printf '%s\n' "$OUT" | grep -E "BROKEN|->|^-" | head -40
      echo "pre-commit: import-linter contracts of $proj are broken (uv run --project $proj --group dev lint-imports --config $proj/pyproject.toml)"; exit 1; }
  done
fi

# 3. unit tests
# the output is kept: a failure that a retry did not repeat went unnamed twice (TASK-14, 2026-10-11)
TEST_LOG="$(git rev-parse --git-dir)/maisecrets-pre-commit-tests.log"
python3 -m unittest discover -s tests -q >"$TEST_LOG" 2>&1 || {
  grep -E '^(FAIL|ERROR):' "$TEST_LOG"; tail -25 "$TEST_LOG"
  echo "pre-commit: unit tests failed (full output: $TEST_LOG)"; exit 1; }
exit 0
