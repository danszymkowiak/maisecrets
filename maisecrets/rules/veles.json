"regex": "(?s)\"user_(?P<TOKEN_ID>[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})_token_apiKeyClientSecret\"\\s*:.{0,20}?\"(?P<TOKEN>[A-Za-z0-9]{10,50})\"",
"secret_group": 2,
"source": "https://raw.githubusercontent.com/google/osv-scalibr/e8621f1fff93beb5b70e5d6ba5fdc3e9854ec845/veles/secrets/bitwardenoauth2access/detector.go"
},
