{
"id": "veles.secrets/bitbucketcredentials",
"name": "Bitbucket Git Credentials",
"path": "(?i)(?:\\.git[/\\\\]config|(?:^|[/\\\\])\\.git-credentials|_history)$",
"regex": "(?P<TOKEN>\\bhttps://(?P<GIT_USERNAME>[^:\\s]+):(?P<GIT_PASSWORD>[^\\s@]+)@bitbucket\\.org/[^\\s]+\\.git\\b)",
"secret_group": 0,
"source": "https://raw.githubusercontent.com/google/osv-scalibr/e8621f1fff93beb5b70e5d6ba5fdc3e9854ec845/veles/secrets/gitbasicauth/bitbucket/detector.go"
},
{
